
#
# Generic Style
#
# A neutral fallback: matplotlib's own defaults, plus a few generally useful
# readability tweaks and the library-wide Petroff color cycle (no
# experiment-specific fonts or tick sizing).
# Bundle your own .mplstyle and register it via afplotter.experiments.registry
# for anything more specific.

figure.facecolor: white
axes.facecolor: white
axes.grid: False

# Petroff 10 (arXiv:2107.02270) minus its red 'bd1f01', which is reserved for signal.
axes.prop_cycle: cycler('color', ['3f90da', 'ffa90e', '94a4a2', '832db6', 'a96b59', 'e76300', 'b9ac70', '717581', '92dadd'])

legend.frameon: False

xtick.direction: out
ytick.direction: out
xtick.minor.visible: True
ytick.minor.visible: True

axes.formatter.use_mathtext: True
